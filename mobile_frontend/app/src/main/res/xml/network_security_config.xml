<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Enable cleartext HTTP traffic for development and demo media URLs.
         For production, restrict to specific domains as needed. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
