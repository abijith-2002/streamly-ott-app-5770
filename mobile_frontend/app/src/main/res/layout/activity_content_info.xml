<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContentInfo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/streamly_black">

    <!-- Header with poster image and gradient/text overlay -->
    <FrameLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="420dp">

        <ImageView
            android:id="@+id/detailPosterImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:contentDescription="@string/poster_content_desc"
            android:src="@drawable/poster_placeholder" />

        <!-- Bottom gradient overlay blending into #090808 -->
        <View
            android:id="@+id/gradientOverlay"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bottom_gradient_overlay" />

        <!-- Text + CTA overlayed over the gradient, anchored to bottom -->
        <LinearLayout
            android:id="@+id/overlayContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/infoTitle"
                style="@style/TextAppearance.Figtree.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/streamly_on_surface"
                android:maxLines="2"
                android:ellipsize="end"
                android:fontFamily="@font/figtree_bold"
                android:text="" />

            <TextView
                android:id="@+id/infoDescription"
                style="@style/TextAppearance.Figtree.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/streamly_on_surface"
                android:maxLines="3"
                android:ellipsize="end"
                android:text="" />

            <Button
                android:id="@+id/watchNowButton"
                style="@style/TextAppearance.Figtree.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/watch_now"
                android:textColor="@color/streamly_on_surface"
                android:background="@drawable/btn_watch_now_background"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textStyle="bold"
                android:drawableStart="@drawable/play"
                android:drawableLeft="@drawable/play"
                android:drawablePadding="8dp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/infoProgress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Optional spacer below header to allow simple scrolling; can be omitted if not needed -->
    <ScrollView
        android:id="@+id/extraContentScroll"
        android:layout_below="@id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/extraContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <!-- Placeholder for future sections (seasons, episodes) -->
        </LinearLayout>
    </ScrollView>

</RelativeLayout>
